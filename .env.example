# Paths only. Copy outside the repository and replace ROOT_FOLDER_ID with the approved ID.
export GDRIVE_SA_KEY_FILE="${HOME}/.config/gdrive-upload/service-account.json"
export GDRIVE_ROOT_FOLDER_ID="ROOT_FOLDER_ID"
export GDRIVE_PYTHON="${HOME}/.local/share/gdrive-upload/venv/bin/python"
# GOOGLE_APPLICATION_CREDENTIALS is an alternative to GDRIVE_SA_KEY_FILE, not another key.
